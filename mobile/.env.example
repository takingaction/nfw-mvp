# Copy to .env (git-ignored) and fill in.
# EXPO_PUBLIC_* vars are bundled into the app binary — never put secrets here.

# Supabase (same project as the web app). Custom auth domain is active.
EXPO_PUBLIC_SUPABASE_URL=https://auth.nationalfundforwomen.org
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NFW web API base. The mobile app calls existing Vercel API routes here.
# development: http://localhost:3000 (or your LAN IP for a physical device)
# preview/production: https://nationalfundforwomen.org
EXPO_PUBLIC_API_BASE_URL=https://nationalfundforwomen.org

# Optional: EAS project ID (populated by `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=

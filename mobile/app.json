{
  "expo": {
    "name": "National Fund for Women",
    "slug": "nfw-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nfw",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F5F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.nationalfundforwomen.app",
      "associatedDomains": [
        "applinks:nationalfundforwomen.org"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow NFW to access your photos so you can set a profile picture or attach receipts to grant applications.",
        "NSCameraUsageDescription": "Allow NFW to use your camera so you can take a profile picture or photograph receipts for grant applications."
      }
    },
    "android": {
      "package": "org.nationalfundforwomen.app",
      "adaptiveIcon": {
        "backgroundColor": "#3E145F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nationalfundforwomen.org",
              "pathPrefix": "/perks"
            },
            {
              "scheme": "https",
              "host": "nationalfundforwomen.org",
              "pathPrefix": "/grants"
            },
            {
              "scheme": "https",
              "host": "nationalfundforwomen.org",
              "pathPrefix": "/store"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3E145F"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3E145F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NFW to access your photos so you can attach receipts and documents to grant applications.",
          "cameraPermission": "Allow NFW to use your camera so you can photograph receipts and documents for grant applications."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f7802b0-60fc-4623-809f-cf26fe7e06dd"
      }
    },
    "owner": "my-hero-creative"
  }
}

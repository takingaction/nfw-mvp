{
  "_comment": "Source of truth for skeleton screens. Run `node scripts/generate-placeholders.mjs` to (re)create any missing route files. Existing files are never overwritten.",
  "routes": [
    {
      "file": "app/+not-found.tsx",
      "component": "NotFoundScreen",
      "title": "Page Not Found",
      "web": [
        "app/not-found.tsx"
      ],
      "phase": 1,
      "notFound": true
    },
    {
      "file": "app/auth/login.tsx",
      "component": "LoginScreen",
      "title": "Member Login",
      "web": [
        "app/auth/login/page.tsx",
        "components/login-form.tsx"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/sign-up/index.tsx",
      "component": "SignUpScreen",
      "title": "Become a Member",
      "web": [
        "app/auth/sign-up/page.tsx",
        "components/SignUpFlow.tsx (step 0)",
        "GET /api/signup"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/sign-up/profile.tsx",
      "component": "SignUpProfileScreen",
      "title": "Personal Info",
      "web": [
        "components/SignUpFlow.tsx (step 1)",
        "POST /api/profile/update"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/sign-up/identity.tsx",
      "component": "SignUpIdentityScreen",
      "title": "About You",
      "web": [
        "components/SignUpFlow.tsx (step 2)",
        "POST /api/profile/update"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/sign-up/membership.tsx",
      "component": "SignUpMembershipScreen",
      "title": "Choose Membership",
      "web": [
        "components/SignUpFlow.tsx (step 3)",
        "POST /api/waitlist"
      ],
      "phase": 2,
      "notes": "Paid tiers open nationalfundforwomen.org in the system browser (Apple 3.1.1). Free → waitlist via POST /api/waitlist."
    },
    {
      "file": "app/auth/sign-up-success.tsx",
      "component": "SignUpSuccessScreen",
      "title": "Check Your Email",
      "web": [
        "app/auth/sign-up-success/page.tsx"
      ],
      "phase": 2,
      "notes": "Resend confirmation via supabase.auth.resend({ type: 'signup' }) with 60s cooldown."
    },
    {
      "file": "app/auth/forgot-password.tsx",
      "component": "ForgotPasswordScreen",
      "title": "Reset Password",
      "web": [
        "app/auth/forgot-password/page.tsx"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/update-password.tsx",
      "component": "UpdatePasswordScreen",
      "title": "New Password",
      "web": [
        "app/auth/update-password/page.tsx",
        "POST /api/auth/update-password"
      ],
      "phase": 2,
      "notes": "Calls supabase.auth.updateUser directly — no cookie exchange needed on mobile."
    },
    {
      "file": "app/auth/welcome.tsx",
      "component": "WelcomeScreen",
      "title": "Welcome to NFW",
      "web": [
        "app/auth/welcome/page.tsx"
      ],
      "phase": 2
    },
    {
      "file": "app/auth/waitlist-confirmed.tsx",
